generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model MonitoredService {
  id                 String              @id @default(cuid())
  name               String              @unique
  provider           String
  endpoint           String
  enabled            Boolean             @default(true)
  slackEnabled       Boolean             @default(true)
  components         ServiceComponent[]
  incidents          Incident[]
  notificationEvents NotificationEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ServiceComponent {
  id         String           @id @default(cuid())
  serviceId  String
  externalId String
  name       String
  status     String
  updatedAt  DateTime?
  checkedAt  DateTime         @default(now())
  service    MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, externalId])
  @@index([serviceId])
}

model Incident {
  id                 String              @id @default(cuid())
  serviceId          String
  externalId         String
  title              String
  status             String
  impact             String?
  url                String?
  startedAt          DateTime?
  updatedAt          DateTime?
  resolvedAt         DateTime?
  isMaintenance      Boolean             @default(false)
  shouldNotify       Boolean             @default(true)
  rawPayload         String              @default("{}")
  firstSeenAt        DateTime            @default(now())
  lastSeenAt         DateTime            @updatedAt
  service            MonitoredService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@unique([serviceId, externalId])
  @@index([serviceId, status])
  @@index([serviceId, updatedAt])
}

model NotificationEvent {
  id           String           @id @default(cuid())
  serviceId    String
  incidentId   String?
  dedupeKey    String           @unique
  eventType    String
  slackStatus  String
  slackChannel String?
  errorMessage String?
  createdAt    DateTime         @default(now())
  service      MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incident     Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
}

model WorkerRun {
  id               String    @id @default(cuid())
  status           String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  providersChecked Int       @default(0)
  providersFailed  Int       @default(0)
  errorMessage     String?
}
