<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.service-alert.web</string>
  <key>WorkingDirectory</key>
  <string>/path/to/service-alert</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Use an absolute Node 22 path. launchd does not read fnm/nvm shell init files. -->
    <string>/path/to/node-v22/bin/node</string>
    <string>/path/to/node-v22/lib/node_modules/corepack/dist/pnpm.js</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/path/to/node-v22/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DATABASE_URL</key>
    <string>file:./dev.db</string>
    <key>PORT</key>
    <string>3333</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/service-alert/logs/web.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/service-alert/logs/web.err.log</string>
</dict>
</plist>
